rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Admin helper
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.admin == true ||
        request.auth.token.email == "20sgamingrohit@gmail.com"
      );
    }

    // Public / Authenticated Thumbnails
    match /thumbnails/{projectId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // Private Project Files (ZIP, RAR, PDF, INO, GERBER, etc.)
    // Note: Subscriber downloads MUST be authorized through backend serverless API
    // which generates short-lived V4 signed URLs. Direct reads are strictly restricted.
    match /projects/{projectId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
