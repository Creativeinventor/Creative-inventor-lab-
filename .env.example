# ==============================================================================
# Creative Inventor Project Portal - Environment Configuration
# ==============================================================================
#
# IMPORTANT: Never commit your actual .env file or private keys to git repository.
# Follow the README instructions to obtain credentials from Firebase Console and Resend.

# ------------------------------------------------------------------------------
# 1. CLIENT-SIDE FIREBASE CONFIGURATION (Vite public variables)
# ------------------------------------------------------------------------------
# Obtained from: Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY="AIzaSyYourFirebaseWebApiKeyHere"
VITE_FIREBASE_AUTH_DOMAIN="creative-inventor-portal.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="creative-inventor-portal"
VITE_FIREBASE_STORAGE_BUCKET="creative-inventor-portal.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="123456789012"
VITE_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890"

# ------------------------------------------------------------------------------
# 2. SERVER-SIDE FIREBASE ADMIN SDK (Private credentials - NEVER expose to client)
# ------------------------------------------------------------------------------
# Obtained from: Firebase Console -> Project Settings -> Service accounts -> Generate new private key
FIREBASE_PROJECT_ID="creative-inventor-portal"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@creative-inventor-portal.iam.gserviceaccount.com"
# Note: In Vercel or environment files, preserve newlines or wrap in double quotes with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQD...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# 3. RESEND EMAIL CONFIGURATION
# ------------------------------------------------------------------------------
# Obtained from: https://resend.com/api-keys and https://resend.com/domains
RESEND_API_KEY="re_123456789_abcdefghijklmnopqr"
RESEND_FROM_EMAIL="Creative Inventor <portal@yourdomain.com>"

# ------------------------------------------------------------------------------
# 4. APPLICATION & SECURITY SETTINGS
# ------------------------------------------------------------------------------
# Full base URL where the portal is hosted (e.g., https://creative-inventor.vercel.app or http://localhost:3000)
APP_URL="http://localhost:3000"

# Secret token required to authenticate Vercel Cron jobs or external trigger calls
CRON_SECRET="generate_a_secure_random_cron_secret_key_here"

# ------------------------------------------------------------------------------
# 5. INITIAL ADMIN ACCOUNT CONFIGURATION (Single-admin portal)
# ------------------------------------------------------------------------------
# The administrator User ID used to log in (resolves to ADMIN_EMAIL automatically)
ADMIN_USER_ID="admin"

# Valid administrator email address associated with Firebase Authentication
ADMIN_EMAIL="20sgamingrohit@gmail.com"

# Initial administrator password (never hardcoded in production; change immediately)
ADMIN_INITIAL_PASSWORD="123"

# Administrator Display Name
ADMIN_NAME="Administrator"

